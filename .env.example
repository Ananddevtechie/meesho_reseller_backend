GEMINI_API_KEY=put_your_key_here
GEMINI_MODEL=gemini-2.0-flash
DATABASE_URL=postgresql+psycopg2://postgres.<PROJECT_REF>:YOUR_URL_ENCODED_PASSWORD@<POOLER_HOST>:5432/postgres?sslmode=require
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=use-a-strong-unique-password

# Telegram order notifications. Create a bot with BotFather, send it /start,
# and set the bot token and your private chat ID in backend/.env.
COD_SHIPPING_FEE=0.00
COD_TAX_AMOUNT=0.00
COD_FEE=0.00
COD_EXPECTED_DELIVERY_RANGE=To be confirmed

# Razorpay setup: verify your merchant account, generate Test Mode API keys, and
# create a Dashboard Checkout Configuration restricted to UPI. Enable automatic
# payment capture. Set the configuration ID and secrets below in backend/.env.
# Before going live, configure the order.paid webhook at
# /api/payments/razorpay/webhook and use the matching webhook secret. Never expose
# API or webhook secrets to the frontend; replace Test keys with Live keys only
# after end-to-end testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_CHECKOUT_CONFIG_ID=
RAZORPAY_WEBHOOK_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Business Cloud API (keep the access token secret; never put it in frontend code).
# Use an approved Utility template named as configured below, with seven body variables:
# order ID, customer name, product title, quantity, payable total, mobile, formatted delivery address.
# Suggested body: "COD order {{1}} from {{2}}. Product: {{3}}. Qty: {{4}}. Total: {{5}}. Mobile: {{6}}. Delivery: {{7}}."
# Recipients must have opted in to receive WhatsApp messages from the business.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=cod_order_notification
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_RECIPIENT_PHONE=8590786095